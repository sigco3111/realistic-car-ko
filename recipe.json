{
	"mode": "browser",
	"block": {
		"controls": [
			{
				"id": "view",
				"label": "시점",
				"hint": "차 뒤에서 보거나 운전석에서 봅니다. 주행 중 V로 바꿉니다.",
				"type": "choice",
				"options": [
					{
						"value": "chase",
						"label": "추적"
					},
					{
						"value": "driver",
						"label": "운전석"
					}
				],
				"default": "chase",
				"essential": true
			},
			{
				"id": "map",
				"label": "맵",
				"hint": "숲을 도는 랠리 스테이지 또는 낡은 야드.",
				"type": "choice",
				"options": [
					{
						"value": "stage",
						"label": "스테이지"
					},
					{
						"value": "yard",
						"label": "야드"
					}
				],
				"default": "stage",
				"essential": true
			},
			{
				"id": "assists",
				"label": "주행 보조",
				"hint": "ABS, 트랙션 컨트롤, 스티어링 보조. 끄면 조향과 브레이크가 그대로 잠깁니다.",
				"type": "toggle",
				"default": true,
				"essential": true
			},
			{
				"id": "grip",
				"label": "그립",
				"hint": "모든 노면에서 타이어가 버티는 정도. 1이 실제 타이어입니다.",
				"type": "number",
				"min": 0.4,
				"max": 1.35,
				"step": 0.05,
				"default": 1,
				"essential": true
			},
			{
				"id": "stiffness",
				"label": "서스펜션",
				"hint": "스프링 강성. 낮으면 차체가 기울고 앞이 파묻히고, 높으면 평평하게 유지됩니다.",
				"type": "number",
				"min": 0.6,
				"max": 2.2,
				"step": 0.05,
				"default": 1
			},
			{
				"id": "slow",
				"label": "슬로우 모션",
				"hint": "차를 포함해 세상 전체가 느려집니다. 0은 정상 속도, 0.9는 1/10 속도입니다.",
				"type": "number",
				"min": 0,
				"max": 0.9,
				"step": 0.05,
				"default": 0
			},
			{
				"id": "power",
				"label": "출력",
				"hint": "엔진 출력을 원래 차 대비 비율로 정합니다.",
				"type": "number",
				"min": 0.4,
				"max": 2.5,
				"step": 0.05,
				"default": 1
			},
			{
				"id": "drive",
				"label": "앞바퀴 구동",
				"hint": "앞바퀴로 가는 구동력: 0은 후륜 구동, 1은 전륜 구동. 0 미만이면 원래 차 설정입니다.",
				"type": "number",
				"min": -0.05,
				"max": 1,
				"step": 0.05,
				"default": -0.05
			},
			{
				"id": "lock",
				"label": "조향각",
				"hint": "앞바퀴가 꺾이는 최대 각도를 원래 차 대비 비율로 정합니다.",
				"type": "number",
				"min": 0.5,
				"max": 1.4,
				"step": 0.05,
				"default": 1
			},
			{
				"id": "flip_wait",
				"label": "전복 후 복구 시간",
				"hint": "지붕이나 옆면으로 뒤집힌 뒤 스스로 일어날 때까지의 시간입니다.",
				"type": "number",
				"min": 0.5,
				"max": 10,
				"step": 0.5,
				"default": 3,
				"unit": "초"
			}
		],
		"presets": [],
		"triggers": [
			{
				"id": "reset",
				"label": "리셋",
				"hint": "처음으로: 모든 설정, 차, 상자, 마네킹, 시점이 돌아갑니다."
			}
		]
	},
